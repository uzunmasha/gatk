nextflow_process {

    name "INDEX_BAM module tests"
    script "modules/local/index_bam/main.nf"
    process "INDEX_BAM"

    test("Should index a valid sorted bam file") {

        when {
            params {
                input_data_dir = "tests/results"
            }
            process {
                """
                input[0] = [[id: 'hg002_gm24385_sub'], file("${projectDir}/test_data/modules/index_bam/hg002_gm24385_sub_sorted.bam")]
                """
            }
        }

        then {
            assert process.success

            def outTuple = process.out.indexed_bam.get(0)
            assert outTuple[0].id == 'hg002_gm24385_sub'
            assert file(outTuple[1]).name == 'hg002_gm24385_sub_sorted.bam'
            assert file(outTuple[2]).name == 'hg002_gm24385_sub_sorted.bam.bai'
            assert file(outTuple[2]).size() > 0
        }
    }

    test("Should fail when bam file doesn't exist") {

        when {
            params {
                input_data_dir = "tests/results"
            }
            process {
                """
                input[0] = [[id: 'invalid'], file("${projectDir}/test_data/modules/index_bam/does_not_exist.bam")]
                """
            }
        }

        then {
            assert !process.success
        }
    }
}
