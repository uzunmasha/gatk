nextflow_process {

    name "CREATE_SEQ_DICT module tests"
    script "modules/local/create_seq_dict/main.nf"
    process "CREATE_SEQ_DICT"

    test("Should create a sequence dictionary for a valid reference") {

        when {
            params {
                input_data_dir = "tests/results"
            }
            process {
                """
                input[0] = [id: 'test_genome']
                input[1] = file("${projectDir}/test_data/chr20.fa")
                """
            }
        }

        then {
            assert process.success

            def dictFile = process.out.dictionary.get(0)
            assert file(dictFile).name == 'chr20.dict'
            assert file(dictFile).size() > 0
        }
    }

    test("Should fail when reference file doesn't exist") {

        when {
            params {
                input_data_dir = "tests/results"
            }
            process {
                """
                input[0] = [id: 'invalid_genome']
                input[1] = file("${projectDir}/test_data/modules/create_seq_dict/does_not_exist.fa")
                """
            }
        }

        then {
            assert !process.success
        }
    }
}
