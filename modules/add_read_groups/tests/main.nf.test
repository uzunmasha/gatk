nextflow_process {

    name "ADD_READ_GROUPS module tests"
    script "modules/add_read_groups/main.nf"
    process "ADD_READ_GROUPS"

    test("Should add read groups for valid sam file") {

        when {
            params {
                input_data_dir = "tests/results"
            }
            process {
                """
                input[0] = [[id: 'hg002_gm24385_sub'], file("${projectDir}/test_data/modules/add_read_groups/hg002_gm24385_sub.sam")]
                """
            }
        }

        then {
            assert process.success

            def outTuple = process.out.read_groups_bam.get(0)
            assert outTuple[0].id == 'hg002_gm24385_sub'
            assert file(outTuple[1]).name == 'hg002_gm24385_sub_rg.bam'
            assert file(outTuple[1]).size() > 0
        }
    }

    test("Should fail when sam file doesn't exist") {

        when {
            params {
                input_data_dir = "tests/results"
            }
            process {
                """
                input[0] = [[id: 'invalid'], file("${projectDir}/test_data/modules/add_read_groups/does_not_exist.sam")]
                """
            }
        }

        then {
            assert !process.success
        }
    }
}
