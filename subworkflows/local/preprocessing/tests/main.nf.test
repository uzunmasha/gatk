nextflow_workflow {

    name "PREPROCESSING subworkflow tests"
    script "subworkflows/local/preprocessing/main.nf"
    workflow "PREPROCESSING"

    test("Should preprocess reads and create indexed bam") {

        when {
            params {
                input_data_dir = "test_data"
            }
            workflow {
                """
                input[0] = Channel.fromList([file("${projectDir}/test_data/chr20.fa")])
                input[1] = Channel.fromList([['hg002_gm24385_sub',
                    file("${projectDir}/test_data/hg002_gm24385_sub_R1.fastq.gz"),
                    file("${projectDir}/test_data/hg002_gm24385_sub_R2.fastq.gz")]])
                input[2] = Channel.fromList([[id: 'hg002_gm24385_sub']])
                """
            }
        }

        then {
            assert workflow.success

            def indexed_bam = workflow.out.indexed_bam_ch.get(0)
            assert indexed_bam[0].id == 'hg002_gm24385_sub'
            assert file(indexed_bam[1]).name.endsWith('sorted.bam')
            assert file(indexed_bam[1]).size() > 0
            assert file(indexed_bam[2]).name.endsWith('sorted.bam.bai')
            assert file(indexed_bam[2]).size() > 0

            def ref_with_index = workflow.out.reference_with_index_and_dict_ch.get(0)
            assert file(ref_with_index[0]).name == 'chr20.fa'
            assert file(ref_with_index[1]).name == 'chr20.fa.fai'
            assert file(ref_with_index[2]).name == 'chr20.dict'
        }
    }

    test("Should fail when reads file doesn't exist") {

        when {
            params {
                input_data_dir = "test_data"
            }
            workflow {
                """
                input[0] = Channel.fromList([file("${projectDir}/test_data/chr20.fa")])
                input[1] = Channel.fromList([['invalid',
                    file("${projectDir}/test_data/nonexistent_R1.fastq.gz"),
                    file("${projectDir}/test_data/nonexistent_R2.fastq.gz")]])
                input[2] = Channel.fromList([[id: 'invalid']])
                """
            }
        }

        then {
            assert !workflow.success
        }
    }
}
