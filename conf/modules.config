process {

    withName: CREATE_GENOME_INDEX {
        publishDir = [
            path: "${params.input_data_dir}/indices",
            mode: 'copy'
        ]
    }

    withName: CREATE_FASTA_INDEX {
        publishDir = [
            path: "${params.input_data_dir}/indices",
            mode: 'copy',
            pattern: '*.fai'
        ]
    }

    withName: CREATE_SEQ_DICT {
        publishDir = [
            path: "${params.input_data_dir}/indices",
            mode: 'copy',
            pattern: '*.dict'
        ]
    }

    withName: ALIGN_READS {
        publishDir = [
            path: "${params.output_dir}/preprocessing/aligned",
            mode: 'copy',
            pattern: '*.sam'
        ]
    }

    withName: ADD_READ_GROUPS {
        ext.args = """
            RGLB=${params.rglb ?: 'lib1'} \
            RGPL=${params.rgpl ?: 'ILLUMINA'} \
            RGPU=${params.rgpu ?: 'unit1'}
        """.trim()
        publishDir = [
            path: "${params.output_dir}/preprocessing/read_groups",
            mode: 'copy',
            pattern: '*_rg.bam'
        ]
    }

    withName: SORT_BAM {
        publishDir = [
            path: "${params.output_dir}/preprocessing/sorted",
            mode: 'copy',
            pattern: '*_sorted.bam'
        ]
    }

    withName: INDEX_BAM {
        publishDir = [
            path: "${params.output_dir}/preprocessing/indexed",
            mode: 'copy',
            pattern: '*.bai'
        ]
    }

    withName: CALL_VARIANTS {
        ext.args = "${params.haplotypecaller_args ?: ''}".trim()
        publishDir = [
            path: "${params.output_dir}/variant_calling/gvcf",
            mode: 'copy',
            pattern: '*.g.vcf'
        ]
    }

    withName: CREATE_GVCF_LIST {
        publishDir = [
            path: "${params.output_dir}/variant_calling/gvcf_lists",
            mode: 'copy',
            pattern: '*_gvcf_list.txt'
        ]
    }

    withName: CONSOLIDATE_GVCFS {
        publishDir = [
            path: "${params.output_dir}/variant_calling/genomicsdb",
            mode: 'copy'
        ]
    }

    withName: GENOTYPE {
        publishDir = [
            path: "${params.output_dir}/variant_calling/genotype",
            mode: 'copy',
            pattern: '*.vcf'
        ]
    }
}
